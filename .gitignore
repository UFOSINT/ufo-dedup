# Byte-compiled / optimized
__pycache__/
*.pyc
*.pyo

# Data files (too large for git)
# README.md files are tracked everywhere — they ARE the scaffolding
*.db
*.db-wal
*.db-shm
*.csv
*.jsonl
*.accdb
*.zip
*.gz
*.parquet
*.xlsx

# JSON files (source data, LLM extraction cache)
*.json
# But keep specific config files if needed:
# !some_config.json

# Environment / secrets
.env

# The legacy in-repo Flask GUI prototype (replaced by ufosint-explorer)
ufo-explorer/

# GeoNames gazetteer data (downloaded at build time, ~30 MB extracted)
geodata/

# Reddit raw scrape data (large, per-post JSON files)
data/raw/reddit/raw/
data/raw/reddit/extracted/

# Model weights (downloaded from HuggingFace at runtime)
data/models/*.bin
data/models/*.pt
data/models/*.safetensors

# Build / run logs
*.log

# Misc
nul
*.png
*.tmp
